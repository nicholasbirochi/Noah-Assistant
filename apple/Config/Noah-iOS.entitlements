<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- App Group: o app grava o resumo e os widgets leem. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.nicholasbirochi.noah</string></array>
    <!-- O token fica no Keychain privado deste app. -->
    <key>keychain-access-groups</key>
    <array><string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string></array>
</dict></plist>
